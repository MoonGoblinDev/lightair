// Background stage for Lightair Effect Stack: blur, remove or replace what isn't the person.
// The person mask is the segmentation's alpha (snapped to the frame's edges by Refine).

uniform float4x4 ViewProj;
uniform texture2d image;     // the processed frame (premultiplied alpha)
uniform texture2d mask_tex;  // segmentation, A = person
uniform texture2d bg_tex;    // Blur: background premultiplied by its weight; Image: the picture
uniform int mode;            // 1 blur, 2 remove, 3 colour, 4 image
uniform float4 bg_color;     // Colour (rgb, a = 1)
uniform float feather;       // 0..1 edge softness
uniform float shift;         // -1..1, positive grows the person
uniform float2 bg_scale;     // Image: cover-fit mapping of the frame's uv into the picture's
uniform float2 bg_offset;
uniform float wrap;          // light wrap: how much background light spills over the edge
uniform int show_mask;       // diagnostics: the person mask as grey
uniform texture2d gf_tex;    // fast guided filter: mean a (x) and b (y) at low res
uniform int use_gf;          // the person mask is a * luma + b, from the frame itself
uniform float gf_eps;        // guided filter regularisation (luma variance)
uniform texture2d gf_guide;  // the guide for the final step: the frame at half size (less noise)

sampler_state linearClamp {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float luma(float3 c)
{
	return dot(c, float3(0.299, 0.587, 0.114));
}

// The mask's value here: the guided filter's a * luma + b (an edge that follows the frame's own
// outline at full resolution), or the mask itself.
float mask_at(float2 uv)
{
	if (use_gf == 1) {
		float2 ab = gf_tex.Sample(linearClamp, uv).xy;
		float4 c = gf_guide.Sample(linearClamp, uv);
		float3 s = c.a > 0.0001 ? c.rgb / c.a : c.rgb;
		return saturate(ab.x * luma(s) + ab.y);
	}
	return mask_tex.Sample(linearClamp, uv).a;
}

// 0 background .. 1 person, with the chosen edge position and softness.
float person(float2 uv)
{
	float m = mask_at(uv);
	float c = 0.5 - shift * 0.35;
	float w = 0.03 + feather * 0.42;
	return smoothstep(c - w, c + w, m);
}

// What sits behind the person at uv (straight colour).
float3 backdrop(float2 uv, float3 fallback)
{
	if (mode == 1) {
		float4 b = bg_tex.Sample(linearClamp, uv);
		// normalised convolution: the person's colours never bleed into the blur
		float3 c = b.rgb / max(b.a, 0.0001);
		return lerp(fallback, c, saturate(b.a * 12.0));
	}
	if (mode == 4)
		return bg_tex.Sample(linearClamp, uv * bg_scale + bg_offset).rgb;
	return bg_color.rgb;
}

float4 PSComposite(VertData v_in) : TARGET
{
	float4 c = image.Sample(linearClamp, v_in.uv);
	float p = person(v_in.uv);
	if (show_mask == 1)
		return float4(p, p, p, 1.0);
	if (mode == 2)
		return c * p; // premultiplied: the layers below show through

	float3 fg = c.a > 0.0001 ? c.rgb / c.a : c.rgb;
	float3 bg = backdrop(v_in.uv, fg);
	// light wrap: a thin band inside the person's edge takes on the background's light, so a
	// replaced background looks like it is lighting the person instead of pasted behind them
	float edge = saturate(p * (1.0 - p) * 4.0);
	fg = lerp(fg, fg * 0.6 + bg * 0.4, edge * wrap);
	return float4(lerp(bg, fg, p), 1.0);
}

technique Composite
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSComposite(v_in);
	}
}

// ---- fast guided filter (He & Sun): image = the frame (low res), mask_tex = the person mask ----

// (I, p, I*I, I*p): the guide's luma and the mask, for their local means.
float4 PSGFPrep(VertData v_in) : TARGET
{
	float4 c = image.Sample(linearClamp, v_in.uv);
	float3 s = c.a > 0.0001 ? c.rgb / c.a : c.rgb;
	float i = luma(s);
	float p = mask_tex.Sample(linearClamp, v_in.uv).a;
	return float4(i, p, i * i, i * p);
}

// From the local means (image): the linear model q = a * I + b that fits the mask best here.
float4 PSGFCoef(VertData v_in) : TARGET
{
	float4 m = image.Sample(linearClamp, v_in.uv);
	float var_i = m.z - m.x * m.x;
	float cov_ip = m.w - m.x * m.y;
	float a = cov_ip / (var_i + gf_eps);
	float b = m.y - a * m.x;
	return float4(a, b, 0.0, 1.0);
}

technique GFPrep
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSGFPrep(v_in);
	}
}

technique GFCoef
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSGFCoef(v_in);
	}
}

// ---- green (or blue) key: macOS's own Backgrounds paints pure green behind the person (Background
// removal's "macOS" model sets that picture), and this takes it out. macOS blends the person's
// edge into the green, so an edge pixel is a * person + (1 - a) * green: its green dominance
// (g - max(r, b)) tells a, and taking the green back out recovers the person's own colour. ----

uniform texture2d key_src;   // GreenKeyPremul: the camera's frame, untouched (where a comes from)
uniform float key_softness;  // 0..1: how far into the edge it stays partly see-through
uniform float2 key_texel;    // one pixel, in uv
uniform int key_blue;        // 1: the backdrop is blue, not green (worked on as if green)

// The key colour's channel as g: blue swaps g and b (its own inverse).
float3 keyed(float3 c)
{
	return key_blue == 1 ? c.rbg : c;
}

// The green's edge, from straight colour. An edge pixel is a * person + (1 - a) * green, so its
// green dominance d = g - max(r, b) is a * d_person + (1 - a) * d_green, and
// a = (d_green - d) / (d_green - d_person). d_green: the camera's green is d ~ 0.8-1 (softness
// lowers the point where it counts as all green). d_person: about 0 (lo) away from the green;
// next to it, the person's own from a few pixels inward (skin is below 0, so a slight green
// mix in it would otherwise not show), which takes the faint green cast out of the inner rim.
// (A parameter, not none: libobs's Metal converter breaks calls to a function with no
// arguments that reads a uniform.)
float key_hi(float softness)
{
	return 0.88 - 0.2 * (1.0 - softness);
}

float dominance(float3 c)
{
	return c.g - max(c.r, c.b);
}

float key_alpha_with(float d, float d_person)
{
	return saturate((key_hi(key_softness) - d) / (key_hi(key_softness) - min(0.03, d_person)));
}

float key_alpha(float3 c)
{
	return key_alpha_with(dominance(c), 0.03);
}

// Around uv, from eight pixels 4 px away: how much green (x, 0 none .. 1 all) and the most
// person-like dominance (y). Two copies (the frame, the untouched frame): OBS's shader
// converter takes no texture arguments.
float2 near_offset(int i)
{
	float ang = float(i) * 0.785398;
	return float2(cos(ang), sin(ang)) * key_texel * 4.0;
}

float2 around(float d0, float dmax, float dmin)
{
	float near = smoothstep(0.02, 0.3, 1.0 - key_alpha_with(dmax, 0.03));
	return float2(near, lerp(0.03, min(dmin, d0), near));
}

float2 around_image(float2 uv, float d0)
{
	float dmax = -1.0;
	float dmin = 1.0;
	for (int i = 0; i < 8; i++) {
		float d = dominance(keyed(image.Sample(linearClamp, uv + near_offset(i)).rgb));
		dmax = max(dmax, d);
		dmin = min(dmin, d);
	}
	return around(d0, dmax, dmin);
}

float2 around_src(float2 uv, float d0)
{
	float dmax = -1.0;
	float dmin = 1.0;
	for (int i = 0; i < 8; i++) {
		float d = dominance(keyed(key_src.Sample(linearClamp, uv + near_offset(i)).rgb));
		dmax = max(dmax, d);
		dmin = min(dmin, d);
	}
	return around(d0, dmax, dmin);
}

// The person's own colour at an edge: the green's share taken out, and what green is left
// (spill) brought down: next to the green, to between the other two channels; elsewhere only to
// the larger of them, so a yellow or green shirt keeps its colour.
float3 unmix(float3 c, float a, float near)
{
	float3 f = (c - (1.0 - a) * float3(0.0, 0.9, 0.0)) / max(a, 0.02);
	float hi = max(f.r, f.b);
	float mid = 0.5 * (f.r + f.b) + 0.25 * abs(f.r - f.b);
	f.g = min(f.g, lerp(hi, mid, near));
	return saturate(f);
}

// The frame on its own (straight alpha out, as libobs filters draw).
float4 PSGreenKey(VertData v_in) : TARGET
{
	float4 c = image.Sample(linearClamp, v_in.uv);
	float3 k = keyed(c.rgb);
	float d = dominance(k);
	float2 n = around_image(v_in.uv, d);
	float a = key_alpha_with(d, n.y);
	return float4(keyed(unmix(k, a, n.x)), a * c.a);
}

// After Lightair Effect Stack's other effects (premultiplied in and out): a from the untouched frame.
float4 PSGreenKeyPremul(VertData v_in) : TARGET
{
	float4 c = image.Sample(linearClamp, v_in.uv);
	float3 s = c.a > 0.0001 ? c.rgb / c.a : c.rgb;
	float d = dominance(keyed(key_src.Sample(linearClamp, v_in.uv).rgb));
	float2 n = around_src(v_in.uv, d);
	float a = key_alpha_with(d, n.y);
	return float4(keyed(unmix(keyed(s), a, n.x)), 1.0) * (a * c.a);
}

technique GreenKey
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSGreenKey(v_in);
	}
}

technique GreenKeyPremul
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSGreenKeyPremul(v_in);
	}
}

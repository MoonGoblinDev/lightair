// Lightair shape mask: keeps the inside of a rounded box (a circle or pill when the radius is
// half the short side), with a soft edge and an optional border. Distances are in pixels.
uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 size;          // source size, px
uniform float2 centre;        // the shape's centre, px (the crop window's centre)
uniform float outside;        // how much of the picture outside the shape shows (crop view)
uniform float2 half_box;      // half extents of the shape, px
uniform float radius;         // corner radius, px
uniform float feather;        // soft edge, px
uniform float border;         // border width, px (0 = none)
uniform float4 border_color;  // straight RGBA

sampler_state textureSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

// Signed distance to a rounded box: negative inside.
float rounded_box(float2 p, float2 b, float r)
{
	float2 q = abs(p) - b + r;
	return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

float4 PSShapeMask(VertData v_in) : TARGET
{
	float4 rgba = image.Sample(textureSampler, v_in.uv);
	rgba.rgb *= (rgba.a > 0.) ? (1. / rgba.a) : 0.;
	float4 source = rgba;

	float2 p = v_in.uv * size - centre;
	float d = rounded_box(p, half_box, radius);
	float edge = max(feather, 0.75);
	float inside = 1.0 - smoothstep(-edge, 0.0, d);

	if (border > 0.) {
		// The border is the outermost `border` pixels of the shape.
		float ring = smoothstep(-border - edge, -border, d);
		rgba = lerp(rgba, float4(border_color.rgb, border_color.a), ring * border_color.a);
		rgba.a = max(rgba.a, ring * border_color.a);
	}
	rgba.a *= inside;
	rgba.rgb *= rgba.a;

	// Crop view: what the crop cuts away shows as a cool, faded ghost around the shape.
	if (outside > 0.001) {
		float grey = dot(source.rgb, float3(0.2126, 0.7152, 0.0722));
		float3 ghost = lerp(source.rgb, float3(grey, grey, grey), 0.55) * float3(0.80, 0.86, 0.95);
		float a = source.a * outside * (1.0 - inside);
		rgba.rgb += ghost * a;
		rgba.a += a;
	}
	return rgba;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSShapeMask(v_in);
	}
}

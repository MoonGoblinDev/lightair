// Pencil on paper.
uniform float amount = 1.0;
uniform float weight = 1.0;

float l_at(float2 uv)
{
	return luma(image.Sample(linearClamp, uv).rgb);
}

float4 PSMain(VertData v_in) : TARGET
{
	float2 t = texel * max(weight, 0.5);
	float2 uv = v_in.uv;
	float gx = l_at(uv + float2(t.x, 0.0)) - l_at(uv - float2(t.x, 0.0));
	float gy = l_at(uv + float2(0.0, t.y)) - l_at(uv - float2(0.0, t.y));
	float e = length(float2(gx, gy));
	float pencil = 1.0 - smoothstep(0.03, 0.3, e);
	float l = l_at(uv);
	float shade = lerp(0.82, 1.0, smoothstep(0.15, 0.6, l));
	float paper = 0.96 + (hash12(floor(uv * size * 0.5)) - 0.5) * 0.04;
	float3 sketch = float3(1.0, 1.0, 1.0) * pencil * shade * paper;
	float4 c = image.Sample(linearClamp, uv);
	return float4(lerp(unpremul(c), sketch, amount) * c.a, c.a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMain(v_in);
	}
}

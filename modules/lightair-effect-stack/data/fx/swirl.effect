// Twist around the centre.
uniform float amount = 0.5;
uniform float radius = 0.5;

float4 PSMain(VertData v_in) : TARGET
{
	float2 p = to_square(v_in.uv);
	float r = length(p) / max(radius, 0.01);
	if (r < 1.0) {
		float a = amount * 4.0 * (1.0 - r) * (1.0 - r);
		float cs = cos(a), sn = sin(a);
		p = float2(cs * p.x - sn * p.y, sn * p.x + cs * p.y);
	}
	return image.Sample(linearClamp, from_square(p));
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMain(v_in);
	}
}

// Darkened edges.
uniform float amount = 0.5;
uniform float vignette_size = 0.55;
uniform float softness = 0.5;
uniform float roundness = 1.0;

float4 PSMain(VertData v_in) : TARGET
{
	float4 c = image.Sample(linearClamp, v_in.uv);
	float2 p = (v_in.uv - 0.5) * 2.0;
	p.x *= lerp(1.0, size.x / size.y, roundness);
	float r = length(p) / lerp(1.414, 1.0 + size.x / size.y * 0.414, roundness);
	float v = smoothstep(vignette_size * 0.9, vignette_size * 0.9 + softness * 0.9 + 0.05, r);
	return float4(c.rgb * (1.0 - v * amount), c.a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMain(v_in);
	}
}

// Print dots.
uniform float dot_size = 8.0;
uniform float angle = 0.4;
uniform float colored = 0.0;

float dot_at(float2 px, float a, float v)
{
	float cs = cos(a), sn = sin(a);
	float2 r = float2(cs * px.x - sn * px.y, sn * px.x + cs * px.y);
	float2 cell = frac(r / dot_size) - 0.5;
	float rad = sqrt(saturate(v)) * 0.72;
	float d = length(cell);
	float aa = 1.0 / dot_size;
	return 1.0 - smoothstep(rad - aa, rad + aa, d);
}

float4 PSMain(VertData v_in) : TARGET
{
	float4 c = image.Sample(linearClamp, v_in.uv);
	float3 s = unpremul(c);
	float2 px = v_in.uv * size;
	float ink = dot_at(px, angle, 1.0 - luma(s));
	float3 mono = float3(1.0 - ink, 1.0 - ink, 1.0 - ink);
	float3 cmy = float3(1.0 - dot_at(px, angle + 0.26, 1.0 - s.r),
			    1.0 - dot_at(px, angle + 1.31, 1.0 - s.g),
			    1.0 - dot_at(px, angle, 1.0 - s.b));
	return float4(lerp(mono, cmy, colored) * c.a, c.a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMain(v_in);
	}
}

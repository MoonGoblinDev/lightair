// Miniature look: sharp band, blurred above and below.
uniform float amount = 0.7;
uniform float focus = 0.5;
uniform float focus_size = 0.2;

float spread(float y)
{
	float d = abs(y - focus) - focus_size * 0.5;
	return smoothstep(0.0, 0.3, d) * amount * 8.0;
}

float4 PSH(VertData v_in) : TARGET { return gauss9(v_in.uv, float2(spread(v_in.uv.y), 0.0)); }
float4 PSV(VertData v_in) : TARGET { return gauss9(v_in.uv, float2(0.0, spread(v_in.uv.y))); }
float4 PSFinish(VertData v_in) : TARGET
{
	float4 c = gauss9(v_in.uv, float2(spread(v_in.uv.y) * 0.6, spread(v_in.uv.y) * 0.6));
	float3 s = unpremul(c);
	float l = luma(s);
	return float4(saturate(lerp(float3(l, l, l), s, 1.0 + amount * 0.25)) * c.a, c.a); // a touch more colour, like a toy
}

technique Pass0
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSH(v_in);
	}
}

technique Pass1
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSV(v_in);
	}
}

technique Pass2
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSFinish(v_in);
	}
}

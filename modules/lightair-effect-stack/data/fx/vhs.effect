// Worn videotape: line jitter, a rolling tracking band, colour bleed and noise.
uniform float amount = 0.6;
uniform float tracking = 0.3;
uniform float bleed = 0.5;

float4 PSMain(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	float frame = floor(time * 30.0);
	float row = floor(uv.y * 240.0);
	float jitter = (hash12(float2(row, frame)) - 0.5) * 0.004 * amount;
	float band_y = frac(time * 0.12);
	float band = smoothstep(0.06, 0.0, abs(uv.y - band_y)) * tracking;
	jitter += band * (hash12(float2(row, frame + 3.0)) - 0.5) * 0.06;
	uv.x += jitter;
	float b = bleed * 6.0 * texel.x * (1.0 + amount);
	float4 c = image.Sample(linearClamp, uv);
	float r = unpremul(image.Sample(linearClamp, uv + float2(b, 0.0))).r;
	float bl = unpremul(image.Sample(linearClamp, uv - float2(b, 0.0))).b;
	float3 s = float3(r, unpremul(c).g, bl);
	float l = luma(s);
	s = lerp(float3(l, l, l), s, 1.0 - 0.25 * amount);
	float noise = (hash12(uv * size + frame) - 0.5) * 0.18 * amount + band * (hash12(uv * size * 0.5 + frame) - 0.3) * 0.6;
	float lines = 1.0 - 0.08 * amount * step(0.5, frac(v_in.uv.y * size.y * 0.5));
	return float4(saturate(s * lines + noise) * c.a, c.a);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMain(v_in);
	}
}

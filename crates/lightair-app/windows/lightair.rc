// Lightair's icon and version information (build.rs, Windows).
#include <winver.h>

1 ICON "../../../branding/final/icon/Lightair.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Lightair"
            VALUE "FileDescription", "Lightair"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "lightair"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "lightair.exe"
            VALUE "ProductName", "Lightair"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
